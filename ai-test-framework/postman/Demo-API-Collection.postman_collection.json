    {
      "name": "Public APIs - No Auth",
      "item": [
        {
          "name": "Get Random User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has results\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.results).to.be.an('array');",
                  "    pm.expect(jsonData.results.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"User has name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.results[0].name).to.have.property('first');",
                  "    pm.expect(jsonData.results[0].name).to.have.property('last');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://randomuser.me/api/",
              "protocol": "https",
              "host": [
                "randomuser",
                "me"
              ],
              "path": [
                "api",
                ""
              ]
            },
            "description": "Fetches random user data from RandomUser API"
          },
          "response": []
        },
