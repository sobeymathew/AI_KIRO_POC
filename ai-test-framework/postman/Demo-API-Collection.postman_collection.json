    {
      "name": "CRUD Operations",
      "item": [
        {
          "name": "Create New Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Post created with ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "});",
                  "",
                  "pm.test(\"Response contains sent data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql('Demo Post from Kiro AI');",
                  "    pm.expect(jsonData.body).to.include('Postman MCP');",
                  "});",
                  "",
                  "// Store the created post ID for later use",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('createdPostId', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Demo Post from Kiro AI\",\n  \"body\": \"This post was created to demonstrate Postman MCP integration with the AI Test Framework.\",\n  \"userId\": 1\n}"
            },
