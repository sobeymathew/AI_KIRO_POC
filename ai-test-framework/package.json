{
  "name": "itsm-qa-platform",
  "version": "2.0.0",
  "description": "Enterprise ITSM Quality Assurance Platform - AI-driven End-to-End Test Automation",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:agentforce": "playwright test --grep @agentforce --project=chromium --workers=1",
    "test:agentforce:smoke": "playwright test src/playwright/tests/smoke/agentforce-assistant.spec.ts --project=chromium --workers=1",
    "test:agentforce:regression": "playwright test src/playwright/tests/regression/agentforce-assistant-regression.spec.ts --project=chromium --workers=1",
    "test:agentforce:coverage": "playwright test src/playwright/tests/regression/agentforce-coverage-gaps.spec.ts --project=chromium --workers=1",
    "test:agentforce:e2e": "playwright test src/playwright/tests/e2e/agentforce-journeys.spec.ts --project=chromium --workers=1",
    "test:agentforce:headed": "playwright test --grep @agentforce --project=chromium --workers=1 --headed",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "generate:report": "ts-node src/reporting/dashboards/dashboard-generator.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "traceability": "ts-node src/test-case-management/traceability/rtm-generator.ts",
    "auth:sf-sandbox": "npx ts-node src/playwright/auth/sf-sandbox-auth.setup.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.45.0",
    "allure-playwright": "^2.15.0",
    "dotenv": "^16.4.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^9.5.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
