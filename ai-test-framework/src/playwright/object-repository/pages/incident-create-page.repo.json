{
  "page": "incident-create",
  "url": "/itsm/s/Incident-Form",
  "verifiedAt": "2026-09-15",
  "verifiedBy": "playwright-mcp-healer",
  "workItem": 47,
  "notes": "Requested By and Requested For are auto-populated with the logged-in user. Category and Sub Category are mandatory custom comboboxes (button[aria-label]) whose options carry data-value (visible text is empty). Sub Category is disabled until a Category is selected and its options depend on the chosen Category. Success confirmation text uses the app spelling 'Sucessfully'.",
  "elements": {
    "createIncidentQuickLink": {
      "locator": "a[href=\"/itsm/s/Incident-Form\"]",
      "type": "link",
      "interaction": "click",
      "verified": true
    },
    "requestedForInput": {
      "locator": "input[aria-label=\"Requested For\"]",
      "type": "lookup",
      "interaction": "auto-populated (logged-in user chip)",
      "verified": true
    },
    "urgencySelect": {
      "locator": "select[name=\"Urgency\"]",
      "type": "native-select",
      "interaction": "selectOption({ label })",
      "options": ["High - Productivity Stopped", "Medium - Productivity Impacted", "Low – Productivity not impacted"],
      "verified": true
    },
    "categoryCombobox": {
      "locator": "button[aria-label=\"Category\"]",
      "type": "combobox",
      "interaction": "click trigger then click [role=option][data-value]",
      "verified": true
    },
    "subCategoryCombobox": {
      "locator": "button[aria-label=\"Sub Category\"]",
      "type": "combobox",
      "interaction": "click trigger then click [role=option][data-value] (enabled after Category selected)",
      "verified": true
    },
    "optionByDataValue": {
      "locator": "[role=\"option\"][data-value=\"<value>\"]",
      "type": "combobox-option",
      "interaction": "click",
      "verified": true
    },
    "briefDescriptionInput": {
      "locator": "input[name=\"Briefly_describe_your_issue_or_request\"]",
      "type": "input",
      "interaction": "fill (min 20 chars, max 254)",
      "verified": true
    },
    "detailedDescriptionTextarea": {
      "locator": "textarea",
      "type": "textarea",
      "interaction": "fill (min 20 chars, max 1000)",
      "verified": true
    },
    "submitButton": {
      "locator": "button:has-text(\"Submit\")",
      "type": "button",
      "interaction": "click",
      "verified": true
    },
    "successMessageText": {
      "locator": "getByText(/Incident Created Sucessfully/i)",
      "type": "confirmation",
      "interaction": "assert visible",
      "verified": true
    },
    "incidentNumberText": {
      "locator": "getByText(/INC-\\d+/)",
      "type": "confirmation",
      "interaction": "read text",
      "verified": true
    },
    "finishButton": {
      "locator": "button:has-text(\"Finish\")",
      "type": "button",
      "interaction": "click",
      "verified": true
    }
  }
}
