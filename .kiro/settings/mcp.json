{
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": ["-y", "@anthropic/azure-devops-mcp@latest"],
      "env": {
        "AZURE_DEVOPS_ORG": "YOUR_ORG_NAME",
        "AZURE_DEVOPS_PAT": "YOUR_AZURE_DEVOPS_PAT",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "YOUR_PROJECT_NAME"
      },
      "disabled": true,
      "autoApprove": []
    }
  }
}
